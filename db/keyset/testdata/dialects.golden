## enum ascending after MySQL's empty value
postgres ErrInvalidCursor
mysql    SELECT id AS "id" FROM db.widgets WHERE (widgets.status IN ('pending', 'active', 'archived')) OR ((widgets.status NOT IN ('pending', 'active', 'archived')) AND (widgets.id > 'w_7')) ORDER BY widgets.status ASC, widgets.id ASC LIMIT 11;
sqlite   SELECT id AS "id" FROM widgets WHERE (CAST(widgets.status AS BLOB) IN (CAST('pending' AS BLOB), CAST('active' AS BLOB), CAST('archived' AS BLOB))) OR ((CAST(widgets.status AS BLOB) NOT IN (CAST('pending' AS BLOB), CAST('active' AS BLOB), CAST('archived' AS BLOB))) AND (widgets.id > 'w_7')) ORDER BY (CASE WHEN CAST(widgets.status AS BLOB) = CAST('pending' AS BLOB) THEN 0 WHEN CAST(widgets.status AS BLOB) = CAST('active' AS BLOB) THEN 1 WHEN CAST(widgets.status AS BLOB) = CAST('archived' AS BLOB) THEN 2 WHEN widgets.status IS NOT NULL THEN -1 END) ASC, widgets.id ASC LIMIT 11;

## computed count descending
postgres SELECT id AS "id", COALESCE(( SELECT COUNT(*) FROM public.requests WHERE requests.widget_id = widgets.id )::bigint, 0) AS "widget_row.request_count" FROM public.widgets WHERE ROW(COALESCE(( SELECT COUNT(*) FROM public.requests WHERE requests.widget_id = widgets.id )::bigint, 0), widgets.id) < ROW(3::bigint, 'w_7'::text) ORDER BY COALESCE(( SELECT COUNT(*) FROM public.requests WHERE requests.widget_id = widgets.id )::bigint, 0) DESC, widgets.id DESC LIMIT 11;
mysql    SELECT id AS "id", COALESCE(CAST(( SELECT COUNT(*) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED), 0) AS "widget_row.request_count" FROM db.widgets WHERE (COALESCE(CAST(( SELECT COUNT(*) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED), 0) < CAST(3 AS SIGNED)) OR ((COALESCE(CAST(( SELECT COUNT(*) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED), 0) = CAST(3 AS SIGNED)) AND (widgets.id < 'w_7')) ORDER BY COALESCE(CAST(( SELECT COUNT(*) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED), 0) DESC, widgets.id DESC LIMIT 11;
sqlite   SELECT id AS "id", COALESCE(CAST(( SELECT COUNT(*) FROM requests WHERE requests.widget_id = widgets.id ) AS INTEGER), 0) AS "widget_row.request_count" FROM widgets WHERE (COALESCE(CAST(( SELECT COUNT(*) FROM requests WHERE requests.widget_id = widgets.id ) AS INTEGER), 0), widgets.id) < (3, 'w_7') ORDER BY COALESCE(CAST(( SELECT COUNT(*) FROM requests WHERE requests.widget_id = widgets.id ) AS INTEGER), 0) DESC, widgets.id DESC LIMIT 11;

## computed nullable max ascending
postgres SELECT id AS "id", ( SELECT MAX(requests.size) FROM public.requests WHERE requests.widget_id = widgets.id )::bigint AS "widget_row.biggest" FROM public.widgets WHERE ((( SELECT MAX(requests.size) FROM public.requests WHERE requests.widget_id = widgets.id )::bigint > 2::bigint) OR (( SELECT MAX(requests.size) FROM public.requests WHERE requests.widget_id = widgets.id )::bigint IS NULL)) OR ((( SELECT MAX(requests.size) FROM public.requests WHERE requests.widget_id = widgets.id )::bigint = 2::bigint) AND (widgets.id > 'w_7'::text)) ORDER BY ( SELECT MAX(requests.size) FROM public.requests WHERE requests.widget_id = widgets.id )::bigint ASC, widgets.id ASC LIMIT 11;
mysql    SELECT id AS "id", CAST(( SELECT MAX(requests.size) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED) AS "widget_row.biggest" FROM db.widgets WHERE ((CAST(( SELECT MAX(requests.size) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED) > CAST(2 AS SIGNED)) OR (CAST(( SELECT MAX(requests.size) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED) IS NULL)) OR ((CAST(( SELECT MAX(requests.size) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED) = CAST(2 AS SIGNED)) AND (widgets.id > 'w_7')) ORDER BY CAST(( SELECT MAX(requests.size) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED) IS NULL, CAST(( SELECT MAX(requests.size) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED) ASC, widgets.id ASC LIMIT 11;
sqlite   SELECT id AS "id", CAST(( SELECT MAX(requests.size) FROM requests WHERE requests.widget_id = widgets.id ) AS INTEGER) AS "widget_row.biggest" FROM widgets WHERE ((CAST(( SELECT MAX(requests.size) FROM requests WHERE requests.widget_id = widgets.id ) AS INTEGER) > 2) OR (CAST(( SELECT MAX(requests.size) FROM requests WHERE requests.widget_id = widgets.id ) AS INTEGER) IS NULL)) OR ((CAST(( SELECT MAX(requests.size) FROM requests WHERE requests.widget_id = widgets.id ) AS INTEGER) = 2) AND (widgets.id > 'w_7')) ORDER BY CAST(( SELECT MAX(requests.size) FROM requests WHERE requests.widget_id = widgets.id ) AS INTEGER) ASC NULLS LAST, widgets.id ASC LIMIT 11;

## computed nullable max ascending after a NULL
postgres SELECT id AS "id", ( SELECT MAX(requests.size) FROM public.requests WHERE requests.widget_id = widgets.id )::bigint AS "widget_row.biggest" FROM public.widgets WHERE (( SELECT MAX(requests.size) FROM public.requests WHERE requests.widget_id = widgets.id )::bigint IS NULL) AND (widgets.id > 'w_7'::text) ORDER BY ( SELECT MAX(requests.size) FROM public.requests WHERE requests.widget_id = widgets.id )::bigint ASC, widgets.id ASC LIMIT 11;
mysql    SELECT id AS "id", CAST(( SELECT MAX(requests.size) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED) AS "widget_row.biggest" FROM db.widgets WHERE (CAST(( SELECT MAX(requests.size) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED) IS NULL) AND (widgets.id > 'w_7') ORDER BY CAST(( SELECT MAX(requests.size) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED) IS NULL, CAST(( SELECT MAX(requests.size) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED) ASC, widgets.id ASC LIMIT 11;
sqlite   SELECT id AS "id", CAST(( SELECT MAX(requests.size) FROM requests WHERE requests.widget_id = widgets.id ) AS INTEGER) AS "widget_row.biggest" FROM widgets WHERE (CAST(( SELECT MAX(requests.size) FROM requests WHERE requests.widget_id = widgets.id ) AS INTEGER) IS NULL) AND (widgets.id > 'w_7') ORDER BY CAST(( SELECT MAX(requests.size) FROM requests WHERE requests.widget_id = widgets.id ) AS INTEGER) ASC NULLS LAST, widgets.id ASC LIMIT 11;

## computed nullable max descending, then rank
postgres SELECT id AS "id", ( SELECT MAX(requests.size) FROM public.requests WHERE requests.widget_id = widgets.id )::bigint AS "widget_row.biggest" FROM public.widgets WHERE ((( SELECT MAX(requests.size) FROM public.requests WHERE requests.widget_id = widgets.id )::bigint < 2::bigint) OR ((( SELECT MAX(requests.size) FROM public.requests WHERE requests.widget_id = widgets.id )::bigint = 2::bigint) AND (widgets.rank > 42::bigint))) OR (((( SELECT MAX(requests.size) FROM public.requests WHERE requests.widget_id = widgets.id )::bigint = 2::bigint) AND (widgets.rank = 42::bigint)) AND (widgets.id > 'w_7'::text)) ORDER BY ( SELECT MAX(requests.size) FROM public.requests WHERE requests.widget_id = widgets.id )::bigint DESC, widgets.rank ASC, widgets.id ASC LIMIT 11;
mysql    SELECT id AS "id", CAST(( SELECT MAX(requests.size) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED) AS "widget_row.biggest" FROM db.widgets WHERE ((CAST(( SELECT MAX(requests.size) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED) < CAST(2 AS SIGNED)) OR ((CAST(( SELECT MAX(requests.size) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED) = CAST(2 AS SIGNED)) AND (widgets.`rank` > CAST(42 AS SIGNED)))) OR (((CAST(( SELECT MAX(requests.size) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED) = CAST(2 AS SIGNED)) AND (widgets.`rank` = CAST(42 AS SIGNED))) AND (widgets.id > 'w_7')) ORDER BY CAST(( SELECT MAX(requests.size) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED) IS NOT NULL, CAST(( SELECT MAX(requests.size) FROM db.requests WHERE requests.widget_id = widgets.id ) AS SIGNED) DESC, widgets.`rank` ASC, widgets.id ASC LIMIT 11;
sqlite   SELECT id AS "id", CAST(( SELECT MAX(requests.size) FROM requests WHERE requests.widget_id = widgets.id ) AS INTEGER) AS "widget_row.biggest" FROM widgets WHERE ((CAST(( SELECT MAX(requests.size) FROM requests WHERE requests.widget_id = widgets.id ) AS INTEGER) < 2) OR ((CAST(( SELECT MAX(requests.size) FROM requests WHERE requests.widget_id = widgets.id ) AS INTEGER) = 2) AND (widgets.rank > 42))) OR (((CAST(( SELECT MAX(requests.size) FROM requests WHERE requests.widget_id = widgets.id ) AS INTEGER) = 2) AND (widgets.rank = 42)) AND (widgets.id > 'w_7')) ORDER BY CAST(( SELECT MAX(requests.size) FROM requests WHERE requests.widget_id = widgets.id ) AS INTEGER) DESC NULLS FIRST, widgets.rank ASC, widgets.id ASC LIMIT 11;

## computed float, then name
postgres SELECT id AS "id", COALESCE(( SELECT SUM(requests.amount) FROM public.requests WHERE requests.widget_id = widgets.id )::double precision, 0) AS "widget_row.total" FROM public.widgets WHERE ROW(COALESCE(( SELECT SUM(requests.amount) FROM public.requests WHERE requests.widget_id = widgets.id )::double precision, 0), widgets.name, widgets.id) > ROW(1.25::double precision, 'apple'::text, 'w_7'::text) ORDER BY COALESCE(( SELECT SUM(requests.amount) FROM public.requests WHERE requests.widget_id = widgets.id )::double precision, 0) ASC, widgets.name ASC, widgets.id ASC LIMIT 11;
mysql    SELECT id AS "id", COALESCE(CAST(( SELECT SUM(requests.amount) FROM db.requests WHERE requests.widget_id = widgets.id ) AS DOUBLE), 0) AS "widget_row.total" FROM db.widgets WHERE ((COALESCE(CAST(( SELECT SUM(requests.amount) FROM db.requests WHERE requests.widget_id = widgets.id ) AS DOUBLE), 0) > 1.25) OR ((COALESCE(CAST(( SELECT SUM(requests.amount) FROM db.requests WHERE requests.widget_id = widgets.id ) AS DOUBLE), 0) = 1.25) AND (widgets.name > 'apple'))) OR (((COALESCE(CAST(( SELECT SUM(requests.amount) FROM db.requests WHERE requests.widget_id = widgets.id ) AS DOUBLE), 0) = 1.25) AND (widgets.name = 'apple')) AND (widgets.id > 'w_7')) ORDER BY COALESCE(CAST(( SELECT SUM(requests.amount) FROM db.requests WHERE requests.widget_id = widgets.id ) AS DOUBLE), 0) ASC, widgets.name ASC, widgets.id ASC LIMIT 11;
sqlite   SELECT id AS "id", COALESCE(CAST(( SELECT SUM(requests.amount) FROM requests WHERE requests.widget_id = widgets.id ) AS REAL), 0) AS "widget_row.total" FROM widgets WHERE (COALESCE(CAST(( SELECT SUM(requests.amount) FROM requests WHERE requests.widget_id = widgets.id ) AS REAL), 0), widgets.name, widgets.id) > (1.25, 'apple', 'w_7') ORDER BY COALESCE(CAST(( SELECT SUM(requests.amount) FROM requests WHERE requests.widget_id = widgets.id ) AS REAL), 0) ASC, widgets.name ASC, widgets.id ASC LIMIT 11;

## computed nullable text descending
postgres SELECT id AS "id", ((( SELECT MIN(requests.label) FROM public.requests WHERE requests.widget_id = widgets.id ))) AS "widget_row.label" FROM public.widgets WHERE (((( SELECT MIN(requests.label) FROM public.requests WHERE requests.widget_id = widgets.id ))) < 'b'::text) OR ((((( SELECT MIN(requests.label) FROM public.requests WHERE requests.widget_id = widgets.id ))) = 'b'::text) AND (widgets.id < 'w_7'::text)) ORDER BY (( SELECT MIN(requests.label) FROM public.requests WHERE requests.widget_id = widgets.id )) DESC, widgets.id DESC LIMIT 11;
mysql    SELECT id AS "id", ((( SELECT MIN(requests.label) FROM db.requests WHERE requests.widget_id = widgets.id ))) AS "widget_row.label" FROM db.widgets WHERE (((( SELECT MIN(requests.label) FROM db.requests WHERE requests.widget_id = widgets.id ))) < 'b') OR ((((( SELECT MIN(requests.label) FROM db.requests WHERE requests.widget_id = widgets.id ))) = 'b') AND (widgets.id < 'w_7')) ORDER BY ((( SELECT MIN(requests.label) FROM db.requests WHERE requests.widget_id = widgets.id ))) IS NOT NULL, (( SELECT MIN(requests.label) FROM db.requests WHERE requests.widget_id = widgets.id )) DESC, widgets.id DESC LIMIT 11;
sqlite   SELECT id AS "id", ((( SELECT MIN(requests.label) FROM requests WHERE requests.widget_id = widgets.id ))) AS "widget_row.label" FROM widgets WHERE (((( SELECT MIN(requests.label) FROM requests WHERE requests.widget_id = widgets.id ))) < 'b') OR ((((( SELECT MIN(requests.label) FROM requests WHERE requests.widget_id = widgets.id ))) = 'b') AND (widgets.id < 'w_7')) ORDER BY (( SELECT MIN(requests.label) FROM requests WHERE requests.widget_id = widgets.id )) DESC NULLS FIRST, widgets.id DESC LIMIT 11;

## computed timestamptz ascending
postgres SELECT id AS "id", COALESCE(( SELECT MAX(requests.received) FROM public.requests WHERE requests.widget_id = widgets.id )::timestamp with time zone, '0001-01-01 00:00:00Z'::timestamp with time zone) AS "widget_row.last_received" FROM public.widgets WHERE ROW(COALESCE(( SELECT MAX(requests.received) FROM public.requests WHERE requests.widget_id = widgets.id )::timestamp with time zone, '0001-01-01 00:00:00Z'::timestamp with time zone), widgets.id) > ROW('2026-03-04 10:11:12Z'::timestamp with time zone, 'w_7'::text) ORDER BY COALESCE(( SELECT MAX(requests.received) FROM public.requests WHERE requests.widget_id = widgets.id )::timestamp with time zone, '0001-01-01 00:00:00Z'::timestamp with time zone) ASC, widgets.id ASC LIMIT 11;
mysql    ErrDialect
sqlite   ErrDialect

