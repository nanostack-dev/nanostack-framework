# Code generated by nano gen config from config.go. DO NOT EDIT.
#
# Environment variables of app.Config. Copy the file to .env and fill in the
# required ones. Commented entries show the default, or are optional; an
# environment variable overrides the config files, so set one only to
# override them.

# environment (app.Environment (string); oneof=dev staging prod)
# Deployment environment.
# ENVIRONMENT=dev

# log_level (slog.Level)
# Minimum log level: debug, info, warn or error.
# LOG_LEVEL=info

# debug (bool)
# Expose pprof handlers.
# DEBUG=false

# deployment (string; defaults to env ENVIRONMENT)
# Stack the deploy renderer names in the config file (prod, dev); the process environment when the file leaves it unset.
# DEPLOYMENT=prod

# http.addr (string)
# Address the server listens on.
# HTTP_ADDR=:8080

# http.read_timeout (duration; min=100ms,max=1m)
# Maximum time to read a request, headers included.
# HTTP_READ_TIMEOUT=5s

# http.admin_port (uint16; min=1024)
# TCP port of the admin listener.
# HTTP_ADMIN_PORT=9090

# postgres.url (required; URL; scheme=postgres postgresql)
# Connection URL; the password is redacted in logs.
PG_URL=

# postgres.max_conns (int32; min=1,max=500)
# Maximum open connections.
# PG_MAX_CONNS=10

# billing.due_days (int; min=1,max=365)
# Days before an open invoice is overdue.
# BILLING_DUE_DAYS=30

# billing.from (required; string)
# Sender address for invoice mail.
BILLING_FROM=

# billing.reply_to (optional; string; defaults to env BILLING_FROM)
# Reply-To address of invoice mail; the sender's when unset.
# BILLING_REPLY_TO=

# billing.stripe_key (required; secret; secret)
# Stripe API key.
STRIPE_KEY=

# billing.webhook_secret (optional; secret; secret)
# Webhook signing secret; webhooks are disabled when unset.
# BILLING_WEBHOOK_SECRET=

# billing.cc (optional; list of string)
# Extra recipients of overdue notices.
# BILLING_CC=

# billing.currencies (list of string; oneof=usd eur cad)
# Currencies invoices may use.
# BILLING_CURRENCIES=usd,eur

# billing.late_fee_rate (float64; min=0,max=0.25)
# Share of the invoice charged as a late fee.
# BILLING_LATE_FEE_RATE=0.015

# billing.portal_url (URL; scheme=https)
# Base URL of the hosted invoice page.
# BILLING_PORTAL_URL=https://pay.example.com
