# Code generated by nano gen config from config.go. DO NOT EDIT.
#
# Environment variables of nanoexample.Config. Copy the file to .env and fill in the
# required ones. Commented entries show the default, or are optional; an
# environment variable overrides the config files, so set one only to
# override them.

# app.start_timeout (duration)
# StartTimeout bounds the whole start phase: every Starter together.
# APP_START_TIMEOUT=15s

# app.stop_timeout (duration)
# StopTimeout bounds the stop phase: draining the Runners and every Stopper share it. A Stopper called after it has passed still gets StopGrace, so a slow Runner or Stopper never skips a later Stopper.
# APP_STOP_TIMEOUT=15s

# app.health_timeout (duration)
# HealthTimeout bounds one readiness evaluation, all checks together.
# APP_HEALTH_TIMEOUT=5s

# app.drain_delay (duration)
# DrainDelay is how long Stop keeps the Runners serving after readiness turns unavailable, so a load balancer stops routing new requests to the instance before its listeners close. Set it to at least the load balancer's discovery refresh plus its health-check interval (about 10s behind Traefik with a 5s refresh and a 5s check; periodSeconds × failureThreshold plus a margin on Kubernetes). It is counted inside StopTimeout and must leave at least StopGrace of it for the Runners: Start fails when DrainDelay is above StopTimeout minus StopGrace. That check only guarantees StopGrace: nanoserver's shutdown_timeout must fit in StopTimeout minus DrainDelay. Zero, the default, cancels the Runners at once.
# APP_DRAIN_DELAY=0s

# log.level (string)
# Level is the minimum level: debug, info, warn or error, with optional offsets such as info+2, or a zerolog name (see ParseLevel).
# LOG_LEVEL=info

# log.format (optional; string)
# Format is json or text. Empty picks JSON in production and for any output that is not a terminal, and text on a development terminal.
# LOG_FORMAT=

# log.wire (string)
# Wire is slog or legacy (see Wire).
# LOG_WIRE=slog

# log.environment (string)
# Environment names the deployment, such as production. It is written as "env" on every line.
# ENVIRONMENT=development

# log.service (optional; string)
# Service names the process on every line.
# SERVICE_NAME=

# log.version (optional; string)
# Version names the running release on every line.
# SERVICE_VERSION=

# tracing.sdk_disabled (optional; bool)
# SDKDisabled turns export off (OTEL_SDK_DISABLED=true).
# OTEL_SDK_DISABLED=

# tracing.traces_exporter (optional; string)
# TracesExporter "none" turns export off.
# OTEL_TRACES_EXPORTER=

# tracing.endpoint (optional; string)
# Endpoint is the OTLP/HTTP base URL, such as http://collector:4318. Spans go to its path joined with /v1/traces. Export needs it or TracesEndpoint.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# tracing.traces_endpoint (optional; string)
# TracesEndpoint is the full OTLP/HTTP traces URL, used as given. It wins over Endpoint.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# tracing.sample_ratio (float64; min=0,max=1)
# SampleRatio is the fraction of new root traces that are sampled. A sampled incoming parent (traceparent) is always kept.
# OTEL_TRACES_SAMPLER_ARG=1

# postgres.host (required; string)
# Host is the server host name or address.
POSTGRES_HOST=

# postgres.port (int; min=1,max=65535)
# Port is the server port.
# POSTGRES_PORT=5432

# postgres.user (required; string)
# User is the role to connect as.
POSTGRES_USER=

# postgres.password (optional; secret; secret)
# Password is the password of User. It may stay empty for trust or certificate authentication.
# POSTGRES_PASSWORD=

# postgres.db (required; string)
# DB is the database name.
POSTGRES_DB=

# postgres.sslmode (optional; string)
# SSLMode is the lib/pq sslmode, such as disable or verify-full. Empty keeps the driver default (require).
# POSTGRES_SSLMODE=

# postgres.max_open_conns (int; min=1)
# MaxOpenConns limits the open connections of the pool.
# POSTGRES_MAX_OPEN_CONNS=25

# postgres.max_idle_conns (int; min=0)
# MaxIdleConns limits the idle connections of the pool.
# POSTGRES_MAX_IDLE_CONNS=25

# postgres.conn_max_lifetime (duration)
# ConnMaxLifetime closes a connection after this age.
# POSTGRES_CONN_MAX_LIFETIME=5m

# migrations.enabled (bool)
# Enabled turns the migrations on.
# MIGRATIONS_ENABLED=true

# migrations.base_path (string)
# BasePath is the directory of the migration files.
# MIGRATIONS_BASE_PATH=migrations

# migrations.validate (bool)
# Validate logs a warning for each module migration without a down file.
# MIGRATIONS_VALIDATE=true

# migrations.auto_fix_dirty (bool)
# AutoFixDirty forces a dirty version to clean before migrating. Use it only when the failed migration is known to have rolled back.
# MIGRATIONS_AUTO_FIX_DIRTY=false

# migrations.force_version (optional; uint)
# ForceVersion, when not zero, sets the version without running any migration, for a manual repair.
# MIGRATIONS_FORCE_VERSION=

# pglock.table_name (string)
# TableName is the lock table.
# PGLOCK_TABLE_NAME=pglock_locks

# pglock.auto_create_table (bool)
# AutoCreateTable creates the table when it does not exist.
# PGLOCK_AUTO_CREATE_TABLE=true

# pglock.lease_duration (duration)
# LeaseDuration is how long a lock stays held without a heartbeat.
# PGLOCK_LEASE_DURATION=10s

# pglock.heartbeat_frequency (duration)
# HeartbeatFrequency is how often a held lock renews its lease. Keep it well below LeaseDuration.
# PGLOCK_HEARTBEAT_FREQUENCY=1s

# pglock.test_on_startup (bool)
# TestOnStartup acquires and releases a random lock while the App is built, so a missing table or permission fails the start, not the first lock.
# PGLOCK_TEST_ON_STARTUP=true

# redis.address (optional; string)
# Address is host:port of the Redis server.
# REDIS_ADDRESS=

# redis.password (optional; secret; secret)
# Password authenticates to the server.
# REDIS_PASSWORD=

# redis.db (optional; int; min=0)
# DB is the Redis logical database.
# REDIS_DB=

# http.host (optional; string)
# Host is the address to bind. Empty binds every interface.
# HTTP_HOST=

# http.port (int; min=0,max=65535)
# Port is the TCP port. 0 picks a free port, for tests.
# HTTP_PORT=8080

# http.read_header_timeout (duration)
# ReadHeaderTimeout bounds reading the request headers.
# HTTP_READ_HEADER_TIMEOUT=30s

# http.read_timeout (duration)
# ReadTimeout bounds reading the whole request.
# HTTP_READ_TIMEOUT=60s

# http.write_timeout (duration)
# WriteTimeout bounds writing the response. Streaming routes extend it per request with http.ResponseController.
# HTTP_WRITE_TIMEOUT=60s

# http.idle_timeout (duration)
# IdleTimeout closes an idle keep-alive connection.
# HTTP_IDLE_TIMEOUT=120s

# http.shutdown_timeout (duration)
# ShutdownTimeout bounds the drain of in-flight requests when the App stops. Keep it below AppConfig.StopTimeout minus AppConfig.DrainDelay. After it, the remaining connections are closed.
# HTTP_SHUTDOWN_TIMEOUT=5s

# pprof.enabled (bool)
# Enabled serves the profiles. Off by default: profiles expose memory contents and cost CPU.
# ENABLE_PPROF=false

# pprof.addr (string)
# Addr is the listen address. Keep it on loopback; reach it through an SSH tunnel or a container exec.
# PPROF_ADDR=127.0.0.1:6060

# pprof.read_header_timeout (duration)
# ReadHeaderTimeout bounds reading the request headers.
# PPROF_READ_HEADER_TIMEOUT=30s

# pprof.read_timeout (duration)
# ReadTimeout bounds reading the whole request.
# PPROF_READ_TIMEOUT=60s

# pprof.write_timeout (duration)
# WriteTimeout bounds writing a profile. A CPU profile of N seconds needs a WriteTimeout above N.
# PPROF_WRITE_TIMEOUT=60s

# pprof.idle_timeout (duration)
# IdleTimeout closes an idle keep-alive connection.
# PPROF_IDLE_TIMEOUT=120s

# pprof.shutdown_timeout (duration)
# ShutdownTimeout bounds the drain when the App stops.
# PPROF_SHUTDOWN_TIMEOUT=5s
