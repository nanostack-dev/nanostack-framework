# OS files
.DS_Store

# Editor files
.idea/
.vscode/
*.iml

# Local env
.env
.env.*
!.env.example

# Build output
dist/
bin/
coverage/

# Agent worktrees, created by git worktree add
worktrees/

# Developer-only Claude settings
/.claude/settings.local.json

# Local Go workspace. Every module builds without it (go.mod replace directives), and CI
# sets GOWORK=off, so a developer's go.work never changes what CI or a release builds.
/go.work
/go.work.sum
